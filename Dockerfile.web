# syntax=docker/dockerfile:1.4
# ----------------------------
# Stage 1: Build Vite frontend
# ----------------------------
  FROM node:22-slim AS frontend

  # Use bash with pipefail
  SHELL ["/bin/bash", "-o", "pipefail", "-c"]

  WORKDIR /app/client

  # Install pnpm (quiet)
  RUN npm install -g pnpm@9.0.0 >/dev/null 2>&1

  # Client bundle keys (EXPO_PUBLIC_*) are supplied at CI build via BuildKit --secret mounts
  # (see Client/scripts/export-bundle-docker-build-args.mjs). Never use ARG/ENV here — values
  # would appear in image metadata and plain build logs.

  # Copy client source (package files first for better layer cache when only app code changes)
  COPY Client/package.json Client/pnpm-workspace.yaml Client/pnpm-lock.yaml ./
  COPY Client/ .
  RUN rm -rf apps/mobile

  # Single install (avoids pnpm fetch which can hang for hours in Docker/CI).
  # 20min timeout so the build fails instead of hanging indefinitely.
  RUN timeout 1200 pnpm install --frozen-lockfile --prod=false --reporter=default \
   && rm -rf /tmp/* || true

  # Headroom for Rollup
  ENV NODE_OPTIONS="--max-old-space-size=3072"

  # Vite build + PostHog bundle verify (secrets mounted per RUN; not persisted to layers)
  RUN --mount=type=secret,id=EXPO_PUBLIC_GOOGLE_MAPS_ID \
      --mount=type=secret,id=EXPO_PUBLIC_POSTHOG_KEY \
      --mount=type=secret,id=EXPO_PUBLIC_PLAID_CLIENT_ID,required=false \
      --mount=type=secret,id=EXPO_PUBLIC_GOOGLE_CLIENT_ID,required=false \
      bash -c 'set -euo pipefail; set +x; \
        export EXPO_PUBLIC_GOOGLE_MAPS_ID="$(cat /run/secrets/EXPO_PUBLIC_GOOGLE_MAPS_ID)"; \
        export EXPO_PUBLIC_POSTHOG_KEY="$(cat /run/secrets/EXPO_PUBLIC_POSTHOG_KEY)"; \
        if [ -f /run/secrets/EXPO_PUBLIC_PLAID_CLIENT_ID ]; then \
          export EXPO_PUBLIC_PLAID_CLIENT_ID="$(cat /run/secrets/EXPO_PUBLIC_PLAID_CLIENT_ID)"; \
        fi; \
        if [ -f /run/secrets/EXPO_PUBLIC_GOOGLE_CLIENT_ID ]; then \
          export EXPO_PUBLIC_GOOGLE_CLIENT_ID="$(cat /run/secrets/EXPO_PUBLIC_GOOGLE_CLIENT_ID)"; \
        fi; \
        pnpm --reporter=silent run -s build:web -- --logLevel warn; \
        VERIFY_POSTHOG=1 NODE_ENV=production node scripts/verify-web-posthog-config.mjs; \
        rm -rf /tmp/*'

  # Verify assets exist (build must produce Client/dist when run from WORKDIR /app/client)
  RUN test -d dist && [ "$(ls -A dist)" ] || (echo "dist missing or empty!" >&2 && exit 1)

  # ----------------------------
  # Stage 2: Build Flask backend (PRODUCTION APP — use `docker build --target backend`)
  # ----------------------------
  FROM python:3.11-slim AS backend

  SHELL ["/bin/bash", "-o", "pipefail", "-c"]

  ENV PYTHONDONTWRITEBYTECODE=1
  ENV PYTHONUNBUFFERED=1

  WORKDIR /app/Server

  # System packages (quiet)
  RUN apt-get update -qq >/dev/null 2>&1 \
   && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -qq \
        build-essential \
        libomp-dev \
        cmake \
        curl \
        libmagic1 \
        file \
        gdal-bin \
        libgdal-dev >/dev/null 2>&1 \
   && apt-get clean >/dev/null 2>&1 \
   && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

  # Python deps (quiet); pins live in Server/requirements/
  COPY Server/requirements ./requirements
  # Install the CPU-only torch wheel first. There is no GPU in production, but the bare
  # `torch==2.10.0` pin in runtime.txt resolves to the multi-GB CUDA wheel from PyPI on
  # linux. Installing 2.10.0+cpu up front satisfies that pin, so the runtime.txt install
  # below does not pull torch (or its CUDA deps) again. Mirrors the CPU-wheel install in
  # .github/workflows/test-callable.yml.
  RUN pip install --upgrade pip setuptools wheel --quiet --disable-pip-version-check \
   && bash scripts/install-torch-cpu.sh \
   && pip install --no-cache-dir --prefer-binary -r requirements/runtime.txt --quiet --disable-pip-version-check \
   && pip cache purge >/dev/null 2>&1 \
   && rm -rf /tmp/* /var/tmp/* ~/.cache/pip

  # App code
  COPY Server/ .

  # Bring built frontend from stage 1
  COPY --from=frontend /app/client/dist /app/Client/dist

  EXPOSE 5000

  RUN chmod +x scripts/gunicorn-entrypoint.sh

  # Env-driven Gunicorn (WEB_CONCURRENCY, GUNICORN_THREADS, GUNICORN_WORKER_CLASS, etc.)
  CMD ["./scripts/gunicorn-entrypoint.sh"]

  # ----------------------------
  # Stage 3: Alembic migrations only (CI / db-migrate-main workflow)
  # NOT the default build target — prod deploy MUST pass `--target backend`.
  # ----------------------------
  FROM python:3.11-slim AS migrate

  SHELL ["/bin/bash", "-o", "pipefail", "-c"]

  ENV PYTHONDONTWRITEBYTECODE=1
  ENV PYTHONUNBUFFERED=1
  ENV SILVERKEY_MIGRATE_ONLY=1
  ENV FLASK_APP=run:app

  WORKDIR /app/Server

  COPY Server/requirements/migrate.txt ./requirements/migrate.txt
  RUN pip install --upgrade pip setuptools wheel --quiet --disable-pip-version-check \
   && pip install --no-cache-dir --prefer-binary -r requirements/migrate.txt --quiet --disable-pip-version-check \
   && pip cache purge >/dev/null 2>&1 \
   && rm -rf /tmp/* /var/tmp/* ~/.cache/pip

  COPY Server/ .

  CMD ["flask", "db", "upgrade"]
