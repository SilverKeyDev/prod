# Copy to `.cursorignore` at repo root (that file may be gitignored locally).
# See AGENTS.md and .cursor/README.md.

# Dependencies and virtualenvs
Server/.venv/
**/node_modules/

# Client build / test output
Client/dist/
Client/coverage/
Client/playwright-report/

# Mobile / native
Client/apps/mobile/ios/Pods/
Client/apps/mobile/dist/
Client/apps/mobile/.expo/

# Python bytecode / binaries
**/__pycache__/
**/*.pyc
**/*.so
**/*.dylib

# Large local logs (if present)
.cursor/debug-*.log
.cursor/.agent-tools/

# Optional: shrink index further (tradeoff: less auto-context for API edits)
# Client/packages/types/api.generated.ts
# Server/app/schemas/generated.py
