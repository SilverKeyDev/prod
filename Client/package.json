{
  "name": "silverkey-client",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @silverkey/web dev",
    "build:web": "pnpm --filter @silverkey/web build",
    "preview:web": "pnpm --filter @silverkey/web preview",
    "dev:mobile": "pnpm --filter @silverkey/mobile start",
    "dev:mobile:clear": "pnpm --filter @silverkey/mobile start:clear",
    "dev:mobile:subpath": "EXPO_MOBILE_BASE_URL=/apps/mobile pnpm --filter @silverkey/mobile start",
    "dev:web:gateway": "VITE_PORT=3000 pnpm --filter @silverkey/web dev",
    "ios": "pnpm --filter @silverkey/mobile ios",
    "ios:native": "pnpm --filter @silverkey/mobile run:ios",
    "android": "pnpm --filter @silverkey/mobile android",
    "lint": "eslint . --config packages/config/eslint/eslint.config.cjs",
    "lint:fix": "eslint . --fix --config packages/config/eslint/eslint.config.cjs",
    "lint:all": "pnpm lint",
    "format": "prettier . --config packages/config/prettier/prettier.config.js --ignore-path packages/config/prettier/.prettierignore --write",
    "format:check": "prettier . --config packages/config/prettier/prettier.config.js --ignore-path packages/config/prettier/.prettierignore --check",
    "typecheck": "tsc -p apps/web/tsconfig.json",
    "typecheck:watch": "pnpm --filter @silverkey/web typecheck:watch",
    "typecheck:mobile": "tsc -p apps/mobile/tsconfig.json",
    "audit": "pnpm audit --audit-level=critical",
    "lint:cycles": "madge --circular --ts-config packages/config/tsconfig/tsconfig.app.json --extensions ts,tsx apps/web packages",
    "fix": "pnpm format && pnpm lint:fix",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:cycles && pnpm audit --audit-level=critical && pnpm build:web",
    "check:all": "pnpm fix && pnpm check",
    "audit:native-duplication": "node scripts/duplication/audit-native-regular-dup.mjs --min-lines 40",
    "audit:native-duplication:json": "node scripts/duplication/audit-native-regular-dup.mjs --min-lines 40 --json",
    "audit:native-duplication:ci": "node scripts/duplication/audit-native-regular-dup.mjs --min-lines 80 --fail-on-duplication",
    "parity:web:record-storage": "node scripts/visual-parity/record-web-storage.mjs",
    "parity:web:screenshots": "node scripts/visual-parity/capture-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@react-email/components": "^0.0.29",
    "@react-email/render": "^1.4.0",
    "@react-email/tailwind": "^0.0.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.9.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-silverkey": "file:packages/config/eslint/eslint-plugin-silverkey",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.9.0",
    "dotenv": "^16.4.5",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "embla-carousel-react": "^8.5.1",
    "framer-motion": "^12.23.12",
    "react-virtuoso": "^4.18.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "dayjs": "^1.11.13",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.544.0",
    "react-phone-number-input": "^3.2.20",
    "react-router-dom": "^7.12.0",
    "typescript-eslint": "^8.45.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "@tanstack/react-query": "5.90.21",
      "@tanstack/query-core": "5.90.20",
      "react-native-svg": "15.12.1"
    }
  }
}
