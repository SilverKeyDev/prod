{
  "name": "silverkey-client",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @silverkey/web dev",
    "build:web": "pnpm --filter @silverkey/web build",
    "verify:web:maps": "node scripts/verify-web-maps-map-id.mjs",
    "preview:web": "pnpm --filter @silverkey/web preview",
    "dev:mobile": "pnpm --filter @silverkey/mobile start",
    "dev:mobile:clear": "pnpm --filter @silverkey/mobile start:clear",
    "dev:mobile:subpath": "EXPO_MOBILE_BASE_URL=/apps/mobile pnpm --filter @silverkey/mobile start",
    "dev:web:gateway": "WEB_DEV_PORT=3000 pnpm --filter @silverkey/web dev",
    "ios": "pnpm --filter @silverkey/mobile ios",
    "ios:clean": "pnpm --filter @silverkey/mobile ios:clean",
    "ios:native": "pnpm --filter @silverkey/mobile run:ios",
    "android": "pnpm --filter @silverkey/mobile android",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint . --config packages/config/eslint/eslint.config.cjs --no-warn-ignored && pnpm stylelint",
    "lint:fix": "eslint . --fix --config packages/config/eslint/eslint.config.cjs --no-warn-ignored && pnpm stylelint:fix",
    "lint:fix:quiet": "eslint . --fix --config packages/config/eslint/eslint.config.cjs --no-warn-ignored --quiet && pnpm stylelint:fix:quiet",
    "lint:all": "pnpm lint",
    "stylelint": "stylelint \"packages/ui/styles/**/*.css\" \"packages/features/**/*.css\" \"apps/mobile/global.css\" \"apps/mobile/tailwind-input.css\" --config packages/config/stylelint/stylelint.config.cjs",
    "stylelint:fix": "pnpm stylelint --fix",
    "stylelint:fix:quiet": "pnpm stylelint --fix -q",
    "format": "prettier . --config packages/config/prettier/prettier.config.js --ignore-path packages/config/prettier/.prettierignore --write",
    "format:fix:quiet": "prettier . --config packages/config/prettier/prettier.config.js --ignore-path packages/config/prettier/.prettierignore --write --log-level silent",
    "format:check": "prettier . --config packages/config/prettier/prettier.config.js --ignore-path packages/config/prettier/.prettierignore --check",
    "typecheck": "tsc -p apps/web/tsconfig.json",
    "typecheck:workspace": "tsc -p packages/config/tsconfig/tsconfig.app.json --noEmit",
    "typecheck:watch": "pnpm --filter @silverkey/web typecheck:watch",
    "typecheck:mobile": "tsc -p apps/mobile/tsconfig.json",
    "audit": "bash scripts/npm-audit-critical.sh",
    "lint:cycles": "madge --circular --warning --ts-config packages/config/tsconfig/tsconfig.app.json --extensions ts,tsx apps/web packages",
    "check:concurrent": "concurrently -g -c auto -n typecheck,lint,format,cycles \"pnpm typecheck\" \"pnpm lint\" \"pnpm format:check\" \"pnpm lint:cycles\"",
    "fix": "pnpm format && pnpm lint:fix",
    "fix:quiet": "pnpm format:fix:quiet && pnpm lint:fix:quiet",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:cycles && pnpm run audit && pnpm build:web",
    "check:all": "pnpm fix && pnpm check",
    "audit:native-duplication": "node scripts/duplication/audit-native-regular-dup.mjs --min-lines 40",
    "audit:native-duplication:json": "node scripts/duplication/audit-native-regular-dup.mjs --min-lines 40 --json",
    "audit:native-duplication:ci": "node scripts/duplication/audit-native-regular-dup.mjs --min-lines 80 --fail-on-duplication",
    "audit:alias-drift": "node scripts/audit-alias-tooling-drift.mjs",
    "generate:bundler-path-manifest": "node scripts/generate-bundler-path-manifest.mjs",
    "audit:cross-feature-imports:json": "node scripts/duplication/audit-cross-feature-imports.mjs --json",
    "parity:web:record-storage": "node scripts/visual-parity/record-web-storage.mjs",
    "parity:web:screenshots": "node scripts/visual-parity/capture-web.mjs",
    "a11y:critical-path": "node scripts/a11y/critical-path-axe.mjs",
    "generate:api-types": "bash scripts/generate-api-types.sh",
    "audit:button-icons": "node scripts/audit-button-icons.mjs"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "11",
    "@axe-core/playwright": "^4.11.3",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-silverkey": "file:packages/config/eslint/eslint-plugin-silverkey",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "expo-blur": "~13.0.2",
    "expo-linear-gradient": "~13.0.2",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.7",
    "madge": "^8.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.55.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^17.11.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.13",
    "embla-carousel-react": "^8.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "framer-motion": "^12.23.12",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.544.0",
    "posthog-js": "^1.376.2",
    "react-phone-number-input": "^3.2.20",
    "react-router-dom": "^7.12.0",
    "react-virtuoso": "^4.18.1",
    "tailwind-merge": "^3.6.0",
    "typescript-eslint": "^8.45.0",
    "yet-another-react-lightbox": "^3.30.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "pnpm": {
    "overrides": {
      "table>ajv": "^8.17.1",
      "glob": ">=10.5.0",
      "@tanstack/react-query": "5.90.21",
      "@tanstack/query-core": "5.90.20",
      "react-native-svg": "15.12.1",
      "tar": ">=7.5.10",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "prismjs": ">=1.30.0",
      "vite": ">=7.1.11",
      "postcss": ">=8.4.31",
      "js-yaml": ">=4.1.1",
      "ajv": "^6.14.0",
      "handlebars": ">=4.7.9",
      "undici@<6.23.0": ">=6.23.0",
      "undici@>=6.0.0 <6.24.0": ">=6.24.0",
      "undici@<6.24.0": ">=6.24.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "node-forge@<=1.3.3": ">=1.4.0",
      "node-forge@<1.4.0": ">=1.4.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=3.0.0 <3.0.2": ">=3.0.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "picomatch": "4.0.4",
      "postcss-load-config@3.1.4>yaml": "2.8.3",
      "yaml@2.8.2": "2.8.3",
      "yaml@>=1.0.0 <1.10.3": ">=1.10.3",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2"
    },
    "patchedDependencies": {
      "eslint-plugin-jsx-a11y@6.10.2": "patches/eslint-plugin-jsx-a11y@6.10.2.patch",
      "eslint-plugin-tailwindcss@3.18.3": "patches/eslint-plugin-tailwindcss@3.18.3.patch"
    }
  }
}
