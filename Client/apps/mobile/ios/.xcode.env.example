# Copy to .xcode.env.local (gitignored) and set your keys.
# Used by Xcode build phases (e.g. Bundle React Native, Inject Google Maps key).

# Google Maps SDK for iOS - must be an API key (starts with AIza...), NOT the Cloud Map ID.
# Create in Google Cloud Console: APIs & Services > Credentials; enable "Maps SDK for iOS".
# Alternatively set EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY in Client/.env (same value).
export GOOGLE_MAPS_IOS_API_KEY=
