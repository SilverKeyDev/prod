# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned (see .xcode.env.example for Google Maps key).

# Load Client root .env so the same vars (API keys, etc.) are available in Xcode.
# PODS_ROOT points to ios/Pods; from there we go up four levels to reach Client/.env.
if [[ -n "${PODS_ROOT}" && -f "${PODS_ROOT}/../../../../.env" ]]; then
  set -a
  source "${PODS_ROOT}/../../../../.env"
  set +a
fi

# Google Maps SDK for iOS requires an API key (from Google Cloud Console, "Maps SDK for iOS").
# Do NOT use the Cloud Map ID (EXPO_PUBLIC_GOOGLE_MAPS_ID) here — that is for styling only.
# Set GOOGLE_MAPS_IOS_API_KEY in Client/.env or create ios/.xcode.env.local (see .xcode.env.example).
if [[ -z "${GOOGLE_MAPS_IOS_API_KEY}" ]]; then
  export GOOGLE_MAPS_IOS_API_KEY="${EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY:-}"
fi

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)