{
  "name": "@silverkey/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run build",
    "format:lint": "npm run format && npm run lint:fix",
    "preview": "vite preview --config vite.config.ts",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "security-check": "echo 'Security audit not configured'",
    "security:ci": "echo 'Security audit not configured'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:run && npm run test:e2e",
    "graph:render": "mmdc -i documentation/graphs/searchpage-layered.mmd -o documentation/graphs/searchpage-layered.svg && mmdc -i documentation/graphs/searchpage-imports.mmd -o documentation/graphs/searchpage-imports.svg",
    "graph:render:watch": "chokidar \"documentation/graphs/*.mmd\" -c \"npm run graph:render\"",
    "render:email": "tsx services/email/render-email.ts"
  },
  "dependencies": {
    "embla-carousel-react": "^8.5.1",
    "@headlessui/react": "^2.2.0",
    "@tanstack/react-query": "^5.87.1",
    "framer-motion": "^12.23.12",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-phone-number-input": "^3.2.20",
    "react-router-dom": "^7.12.0",
    "react-responsive-carousel": "^3.2.23",
    "react-virtuoso": "^4.18.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.55.0",
    "@react-email/components": "^0.0.29",
    "@react-email/render": "^1.4.0",
    "@react-email/tailwind": "^0.0.8",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.55.3",
    "@types/node": "^20.19.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.18",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.2",
    "postcss": "^8.4.35",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  }
}
