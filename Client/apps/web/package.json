{
  "name": "@silverkey/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:force": "vite --force --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "build:analyze": "ANALYZE=1 vite build --config vite.config.js",
    "postbuild": "node ../../scripts/check-web-dist-no-native.mjs ../../dist",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config ../../packages/config/prettier/prettier.config.js --write .",
    "format:check": "prettier --config ../../packages/config/prettier/prettier.config.js --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run build",
    "format:lint": "npm run format && npm run lint:fix",
    "preview": "vite preview --config vite.config.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "pnpm -C ../.. test:run",
    "test:all": "npm run test:run",
    "render:email": "tsx services/email/render-email.ts",
    "lighthouse:audit": "node ../../scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tanstack/react-query": "^5.100.11",
    "driver.js": "^1.4.0",
    "embla-carousel-react": "^8.5.1",
    "framer-motion": "^12.39.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-phone-number-input": "^3.2.20",
    "react-router-dom": "^7.15.1",
    "react-virtuoso": "^4.18.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@react-email/components": "^0.0.29",
    "@react-email/render": "^1.4.0",
    "@react-email/tailwind": "^0.0.8",
    "@rollup/plugin-inject": "^5.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.64.1",
    "@types/node": "^20.19.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.0.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  }
}
