{
  "version": 1,
  "variables": [
    {
      "key": "EXPO_PUBLIC_GOOGLE_MAPS_ID",
      "required": true,
      "dockerBuildArg": true,
      "minLength": 8,
      "forbidPrefix": "AIza",
      "description": "Google Cloud Map ID (not the Maps JavaScript API key). Source: AWS gmaps secret."
    },
    {
      "key": "EXPO_PUBLIC_PLAID_CLIENT_ID",
      "required": false,
      "dockerBuildArg": true,
      "description": "Plaid Link client id. Source: AWS plaid secret."
    },
    {
      "key": "EXPO_PUBLIC_GOOGLE_CLIENT_ID",
      "required": false,
      "dockerBuildArg": true,
      "description": "Google OAuth client id. Source: AWS google_calendar secret."
    },
    {
      "key": "EXPO_PUBLIC_POSTHOG_KEY",
      "required": true,
      "dockerBuildArg": true,
      "pattern": "^phc_",
      "minLength": 10,
      "description": "PostHog project API key (phc_…). Source: AWS posthog secret."
    }
  ]
}
