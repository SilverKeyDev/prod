# Web search map + shared Cloud styling (Vite reads this for apps/web)
# Cloud Map ID from GCP Map Management — NOT the Maps JavaScript API key. See documentation/client/google-maps-web-setup.md
EXPO_PUBLIC_GOOGLE_MAPS_ID=
# Native iOS map styling; also used as web fallback when EXPO_PUBLIC_GOOGLE_MAPS_ID is unset
EXPO_PUBLIC_GOOGLE_MAPS_ID_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_PLAID_CLIENT_ID=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_BASE_URL=