EXPO_PUBLIC_GOOGLE_MAPS_ID=
EXPO_PUBLIC_GOOGLE_MAPS_ID_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_PLAID_CLIENT_ID=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_BASE_URL=

# Optional — web build only (vite.plugin.seo.js via loadEnv in apps/web/vite.config.js; not read by packages/config/env.ts).
# Public origin, no trailing slash. When set, production build emits sitemap.xml and a Sitemap line in robots.txt.
# EXPO_PUBLIC_SITE_URL=https://example.com
# Google Search Console HTML-tag verification content (optional meta injection in built index.html).
# EXPO_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Web dev server port (default 5173). Used by apps/web/vite.config.js.
# WEB_DEV_PORT=3000

# Optional: override the Vite dev proxy target for /api, /healthz, /livez (default http://localhost:5000).
# WEB_API_PROXY=http://127.0.0.1:5000
