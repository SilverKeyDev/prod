{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "paths": {
      "@/features/homeauth/Auth/Button": ["packages/features/homeauth/components/Auth/Button"],
      "@/features/homeauth/Auth/Divider": ["packages/features/homeauth/components/core/Divider"],
      "@/features/homeauth/Auth/Link": ["packages/features/homeauth/components/core/Link"],
      "@/features/homeauth/Auth/PageLayout": [
        "packages/features/homeauth/components/core/PageLayout"
      ],
      "@ui/loading": ["packages/ui/components/asset/loading"],
      "@ui/loading/*": ["packages/ui/components/asset/loading/*"],
      "packages/*": ["packages/*"],
      "packages/config": ["packages/config"],
      "packages/config/*": ["packages/config/*"],
      "packages/contexts": ["packages/contexts"],
      "packages/contexts/*": ["packages/contexts/*"],
      "packages/schemas": ["packages/schemas"],
      "packages/schemas/*": ["packages/schemas/*"],
      "packages/store": ["packages/store"],
      "packages/store/*": ["packages/store/*"],
      "packages/navigation": ["packages/navigation"],
      "packages/navigation/*": ["packages/navigation/*"],
      "packages/utils": ["packages/utils"],
      "packages/utils/*": ["packages/utils/*"],
      "packages/ui": ["packages/ui"],
      "packages/ui/*": ["packages/ui/*"],
      "packages/types": ["packages/types"],
      "packages/types/*": ["packages/types/*"],
      "packages/logger": ["packages/logger"],
      "packages/logger/*": ["packages/logger/*"],
      "packages/hooks": ["packages/hooks"],
      "packages/hooks/*": ["packages/hooks/*"],
      "packages/hooks/data/auth/*": ["packages/features/homeauth/hooks/data/*"],
      "packages/hooks/data/chat": ["packages/features/messaging/hooks/data"],
      "packages/hooks/data/chat/*": ["packages/features/messaging/hooks/data/*"],
      "packages/features/agent/src": ["packages/features/agent/components"],
      "packages/features/agent/src/*": ["packages/features/agent/components/*"],
      "packages/features/dashboard/src": ["packages/features/dashboard/components"],
      "packages/features/dashboard/src/*": ["packages/features/dashboard/components/*"],
      "packages/features/saved/src": ["packages/features/saved/components"],
      "packages/features/saved/src/*": ["packages/features/saved/components/*"],
      "@/features/homeauth/types/user": ["packages/features/homeauth/types"],
      "@/features/homeauth/types/user/*": ["packages/features/homeauth/types/*"],
      "@/features/saved/SavedLayout": ["packages/features/saved/components/SavedLayout"],
      "@/components/ui/button/*": ["packages/ui/components/primitives/button/*"],
      "@/components/ui/form/*": ["packages/ui/components/primitives/form/*"],
      "@/components/ui": ["packages/ui/components"],
      "@/components/ui/*": ["packages/ui/components/*"],
      "@/components/*": ["packages/ui/components/*"],
      "@/features/*": ["packages/features/*"],
      "@/*": ["apps/web/*"],
      "@ui": ["packages/ui/components"],
      "@ui/*": ["packages/ui/components/*"],
      "@/features/documents/data": ["packages/features/documents/hooks/data"],
      "@/features/documents/data/*": ["packages/features/documents/hooks/data/*"],
      "@/features/dashboard/widgets/DocuSignWidget": [
        "packages/features/documents/components/DocuSignWidget"
      ],
      "packages/ui/components/ui": ["packages/ui/components"],
      "packages/ui/components/ui/*": ["packages/ui/components/*"],
      "packages/features/homeauth/Auth/Button": [
        "packages/features/homeauth/components/Auth/Button"
      ],
      "packages/features/homeauth/Auth/Divider": [
        "packages/features/homeauth/components/core/Divider"
      ],
      "packages/features/homeauth/Auth/Link": ["packages/features/homeauth/components/core/Link"],
      "packages/features/homeauth/Auth/PageLayout": [
        "packages/features/homeauth/components/core/PageLayout"
      ],
      "packages/utils/profile": ["packages/features/profile/utils"],
      "packages/utils/profile/*": ["packages/features/profile/utils/*"],
      "packages/utils/error": ["packages/utils/errorHandling/error"],
      "packages/utils/date": ["packages/utils/date"],
      "packages/utils/date/*": ["packages/utils/date/*"],
      "packages/utils/platform": ["packages/utils/platform"],
      "packages/utils/storage/platformStorage": ["packages/utils/storage/platformStorage"]
    },
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "exclude": ["node_modules", "dist"]
}
