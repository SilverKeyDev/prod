# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here
STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Price IDs from Stripe Dashboard
STRIPE_PRICE_5_REPORTS=price_your_price_id_here
STRIPE_PRICE_20_REPORTS=price_your_price_id_here
STRIPE_PRICE_50_REPORTS=price_your_price_id_here
STRIPE_PRICE_UNLIMITED_MONTHLY=price_your_price_id_here
STRIPE_PRICE_UNLIMITED_YEARLY=price_your_price_id_here

# Frontend URL for redirects
FRONTEND_URL=http://localhost:5173

# AWS Configuration (if needed)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# EC2 Configuration (if needed)
EC2_HOST=your_ec2_host
EC2_SSH_KEY=your_ssh_private_key
