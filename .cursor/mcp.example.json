{
  "_comment": "Copy to .cursor/mcp.json (gitignored). Replace YOUR_GITHUB_PAT and Mercury URL. Linear/Slack: connect via Cursor Settings → Tools & MCP. AWS/gcloud: see setup.md / make setup-mcp.",
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_PAT"
      }
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp"
    },
    "mercury": {
      "url": "REPLACE_WITH_URL_FROM_MERCURY_DASHBOARD",
      "_comment": "Read-only banking MCP — paste URL from Mercury dashboard; do not commit real URL in mcp.json"
    },
    "aws-knowledge": {
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "aws-api": {
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1"
      }
    },
    "gcloud": {
      "command": "npx",
      "args": ["-y", "@google-cloud/gcloud-mcp"]
    }
  }
}
