#!/usr/bin/env bash
# Enforce contract and test gates before push.
# Enable hooks for this clone: git config core.hooksPath scripts/githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

echo "pre-push: verifying OpenAPI sync and contract gates..."
make openapi-verify

echo "pre-push: running frontend tests..."
make test-fe

echo "pre-push: running backend tests..."
make test-be

echo "pre-push: all checks passed."
