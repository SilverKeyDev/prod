#!/usr/bin/env bash
# Advisory push hooks: scoped typecheck / contract tests when relevant paths change.
# Never blocks push; CI on PR is the merge gate.
#
# Enable hooks for this clone: git config core.hooksPath scripts/githooks
# Strict manual check: make pre-push-check  (PRE_PUSH_BLOCKING=1)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

export PRE_PUSH_ADVISORY=1
bash "$REPO_ROOT/scripts/ci/pre-push-check.sh" || true
exit 0
